# Extra options for a bug-hunting kernel:  PMP_DEBUG=1 os/kernel/build.sh
# Slow and large; never the default.

# A stray CPU write to kernel text/rodata faults at the writer's PC instead of
# silently corrupting e.g. the scheduler's method tables.
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y

# Use-after-free, out-of-bounds and stale-stack accesses by kernel code,
# reported with allocation and free stacks.
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_OUTLINE=y
CONFIG_KASAN_STACK=y
CONFIG_KASAN_VMALLOC=y
CONFIG_STACKTRACE=y
CONFIG_FRAME_POINTER=y
CONFIG_PANIC_ON_OOPS=y
