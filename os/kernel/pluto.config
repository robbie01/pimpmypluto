# Kernel config fragment, applied on top of allnoconfig:
#   everything the radio needs, nothing it does not.
# No ADI code: the AD936x is driven from userspace over spidev, and the sample
# datapath is ours.

# ---- platform
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_ZYNQ=y
CONFIG_MMU=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y
CONFIG_ARM_THUMB=y
CONFIG_CACHE_L2X0=y
CONFIG_PREEMPT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_250=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_TIMERS=y
# time32 syscalls: needed by any binary built against a pre-1.2 musl or old
# glibc (the prebuilt busybox is one).  Without it sleep() returns at once.
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_KALLSYMS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y

# U-Boot's environment passes maxcpus=1 -- the vendor's way of making this
# board's DDR problem rare.  We fix the DDR problem instead (pluto.dts, &slcr)
# and ignore the bootloader's command line entirely.
CONFIG_CMDLINE="console=ttyPS0,115200 clk_ignore_unused rdinit=/init panic=5 uio_pdrv_genirq.of_id=generic-uio"
CONFIG_CMDLINE_FORCE=y
CONFIG_ARM_APPENDED_DTB=n
CONFIG_USE_OF=y
CONFIG_ATAGS=n

# ---- boot: gzip'd initramfs handed over by U-Boot
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_KERNEL_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_DEBUG_FS=y

# ---- console
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_XILINX_PS_UART=y
CONFIG_SERIAL_XILINX_PS_UART_CONSOLE=y
CONFIG_DEVMEM=y

# ---- network: just enough for IPv6 link-local over USB
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_TCP_CONG_CUBIC=y

# ---- USB device
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y

# ---- SoC peripherals
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_ZYNQ=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ZYNQ=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_CADENCE=y
CONFIG_SPI_SPIDEV=y
CONFIG_SPI_ZYNQ_QSPI=y
CONFIG_SPI_MEM=y
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_SPI_NOR=y
# U-Boot write-protects the boot region (status-register BP bits, which are
# non-volatile).  Leave them exactly as found; the default would clear them.
CONFIG_MTD_SPI_NOR_SWP_KEEP=y
CONFIG_WATCHDOG=y
CONFIG_CADENCE_WATCHDOG=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_RESET_CONTROLLER=y

# ---- FPGA: reload gateware from Linux, no reboot
CONFIG_FPGA=y
CONFIG_FPGA_MGR_ZYNQ_FPGA=y
CONFIG_FPGA_BRIDGE=y
CONFIG_FPGA_REGION=y
CONFIG_OF_FPGA_REGION=y

# ---- sample datapath plumbing
CONFIG_DMADEVICES=y
CONFIG_AXI_DMAC=y
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=128
CONFIG_CMA_ALIGNMENT=9
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_CMA=y

# ---- post-mortem: kernel log kept in RAM across a warm reset (see tools/lastlog.py)
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# ---- CPU errata.  allnoconfig enables none of these and nothing selects them
# for Zynq; the part is a Cortex-A9 r3p0 with a PL310 r3p2.  Correct hygiene,
# all revision-checked at boot -- and none of them the cause of, or a cure
# for, the crashes that were once blamed on their absence.  (742230, 742231,
# 743622 and 751472 need secure-mode writes that a multiplatform kernel leaves
# to the bootloader.)
CONFIG_ARM_ERRATA_720789=y
CONFIG_ARM_ERRATA_754322=y
CONFIG_ARM_ERRATA_754327=y
CONFIG_ARM_ERRATA_764369=y
CONFIG_ARM_ERRATA_775420=y
# Not in mainline: os/kernel/patches/0003.  A real Cortex-A9 MPCore erratum and
# the right thing to apply if a second core is ever enabled -- but verified NOT
# to cure this board's two-core memory corruption (docs/ARCHITECTURE.md).
CONFIG_ARM_ERRATA_845369=y
CONFIG_PL310_ERRATA_588369=y
CONFIG_PL310_ERRATA_727915=y
CONFIG_PL310_ERRATA_753970=y
CONFIG_PL310_ERRATA_769419=y

# ---- stacks: 8 KiB and, without these, unguarded -- an overflow silently
# tramples whatever is next to it and the scheduler falls over later.
CONFIG_VMAP_STACK=y
CONFIG_DEBUG_KERNEL=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_DEBUG_STACK_USAGE=y

# ---- a hang should say what hung (the console log survives in ramoops)
CONFIG_LOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=20
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_WQ_WATCHDOG=y
CONFIG_PANIC_ON_OOPS=y
